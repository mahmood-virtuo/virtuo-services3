Options -MultiViews
RewriteEngine On
RewriteBase /

DirectoryIndex index.php

RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteRule ^blog/$ /blog [R=301,L]
RewriteRule ^blog/(tag|category)/?$ /blog [R=301,L]
RewriteRule ^blog/(tag|category)/([^/]+)/$ /blog/$1/$2 [R=301,L]
RewriteRule ^blog/(mainland-free-zone-or-offshore-uae-structuring-us-founders|why-us-wireless-itad-operators-are-looking-at-the-uae|why-us-wireless-and-itad-operators-are-looking-at-the-uae|uae-business-setup-geopolitics-2026|golden-visa-eligibility-guide|freelance-visa-uae-guide)/$ /blog/$1 [R=301,L]

# --------------------------------------------------
# 1. Old blog detail URLs -> SEO-friendly blog URLs
# --------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+blog-details(?:\.php)?[\s?] [NC]
RewriteRule ^blog-details(?:\.php)?/?$ /blog/mainland-free-zone-or-offshore-uae-structuring-us-founders [R=301,L]

RewriteCond %{THE_REQUEST} \s/+blog-details2(?:\.php)?[\s?] [NC]
RewriteRule ^blog-details2(?:\.php)?/?$ /blog/why-us-wireless-itad-operators-are-looking-at-the-uae [R=301,L]

RewriteCond %{THE_REQUEST} \s/+blog-details3(?:\.php)?[\s?] [NC]
RewriteRule ^blog-details3(?:\.php)?/?$ /blog/uae-business-setup-geopolitics-2026 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+blog-details4(?:\.php)?[\s?] [NC]
RewriteRule ^blog-details4(?:\.php)?/?$ /blog/golden-visa-eligibility-guide [R=301,L]

RewriteCond %{THE_REQUEST} \s/+blog-details5(?:\.php)?[\s?] [NC]
RewriteRule ^blog-details5(?:\.php)?/?$ /blog/freelance-visa-uae-guide [R=301,L]

RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# --------------------------------------------------
# 2. SEO-friendly blog URLs -> real PHP files
# --------------------------------------------------

RewriteRule ^blog/mainland-free-zone-or-offshore-uae-structuring-us-founders/?$ blog-details.php [L,QSA]
RewriteRule ^blog/why-us-wireless-itad-operators-are-looking-at-the-uae/?$ blog-details2.php [L,QSA]
RewriteRule ^blog/why-us-wireless-and-itad-operators-are-looking-at-the-uae/?$ blog-details2.php [L,QSA]
RewriteRule ^blog/uae-business-setup-geopolitics-2026/?$ blog-details3.php [L,QSA]
RewriteRule ^blog/golden-visa-eligibility-guide/?$ blog-details4.php [L,QSA]
RewriteRule ^blog/freelance-visa-uae-guide/?$ blog-details5.php [L,QSA]
RewriteRule ^blog/category/([^/]+)/?$ blog-category.php?category=$1 [L,QSA]
RewriteRule ^blog/tag/([^/]+)/?$ blog-tag.php?tag=$1 [L,QSA]

# --------------------------------------------------
# 3. Redirect direct .php requests to clean URLs
# Example: /about.php -> /about
# --------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --------------------------------------------------
# 4. Let real files and folders load normally
# This protects assets: /assets/css/main.css, images, JS, etc.
# --------------------------------------------------

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --------------------------------------------------
# 5. Serve clean URLs from matching PHP files
# Example: /about -> /about.php
# --------------------------------------------------

RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# --------------------------------------------------
# 6. Custom 404 page
# --------------------------------------------------

ErrorDocument 404 /error
