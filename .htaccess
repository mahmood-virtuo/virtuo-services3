Options -MultiViews
RewriteEngine On
RewriteBase /

DirectoryIndex index.php

# --------------------------------------------------
# 1. Old blog detail URLs -> SEO-friendly blog URLs
# --------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+blog-details(?:\.php)?[\s?] [NC]
RewriteRule ^blog-details(?:\.php)?/?$ /blog/mainland-free-zone-or-offshore-uae-structuring-us-founders [R=301,L]

RewriteCond %{THE_REQUEST} \s/+blog-details2(?:\.php)?[\s?] [NC]
RewriteRule ^blog-details2(?:\.php)?/?$ /blog/why-us-wireless-itad-operators-are-looking-at-the-uae [R=301,L]

# --------------------------------------------------
# 2. SEO-friendly blog URLs -> real PHP files
# --------------------------------------------------

RewriteRule ^blog/mainland-free-zone-or-offshore-uae-structuring-us-founders/?$ blog-details.php [L,QSA]
RewriteRule ^blog/why-us-wireless-itad-operators-are-looking-at-the-uae/?$ blog-details2.php [L,QSA]

# --------------------------------------------------
# 3. Redirect direct .php requests to clean URLs
# Example: /about.php -> /about
# --------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --------------------------------------------------
# 4. Let real files and folders load normally
# This protects assets: /assets/css/main.css, images, JS, etc.
# --------------------------------------------------

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --------------------------------------------------
# 5. Serve clean URLs from matching PHP files
# Example: /about -> /about.php
# --------------------------------------------------

RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# --------------------------------------------------
# 6. Custom 404 page
# --------------------------------------------------

ErrorDocument 404 /error